# ==============================================================
# Attendance Sync Kiosk Configuration
# ==============================================================

# Path to the local SQLite database file
ATTENDANCE_DB_PATH=./wc_attend.db

# Supabase Edge Function Sync Endpoint
# For Local Dev:  http://127.0.0.1:54321/functions/v1/sync-kiosk-attendance
# For Production: https://<your-project-ref>.supabase.co/functions/v1/sync-kiosk-attendance
SYNC_ENDPOINT=https://<your-project-ref>.supabase.co/functions/v1/sync-kiosk-attendance

# Dedicated Attendance Sync Key (configured in Supabase secret ATTENDANCE_SYNC_KEY)
SYNC_API_KEY=your_attendance_sync_key_here

# Polling Interval in seconds (default: 3)
POLL_INTERVAL_SECONDS=3

# Optional: Specific Layout ID override (defaults to current active layout)
# LAYOUT_ID=
